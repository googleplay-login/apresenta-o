{
  "name": "arquipelago-python",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "Arquipélago Python — mundo 3D navegável para estudar Python acompanhando o livro Curso Intensivo de Python (Eric Matthes, Novatec).",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/preparar-pyodide.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/preparar-pyodide.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "preparar-pyodide": "node scripts/preparar-pyodide.mjs",
    "test": "vitest run",
    "pretest": "node scripts/preparar-pyodide.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "pyodide": "314.0.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@react-three/test-renderer": "9.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
